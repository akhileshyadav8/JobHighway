# ─── Database ───
POSTGRES_DB=jobhighway
POSTGRES_USER=jobhighway
POSTGRES_PASSWORD=jobhighway_secret
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://jobhighway:jobhighway_secret@db:5432/jobhighway

# ─── Redis ───
REDIS_URL=redis://redis:6379/0

# ─── Backend ───
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── AI / LLM ───
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

# ─── Polling ───
DEFAULT_POLL_INTERVAL_MINUTES=10
MAX_CONCURRENT_FETCHERS=10

# ─── Frontend ───
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
